generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VIEWER
  EDITOR
  ADMIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccessType {
  FREE
  PREMIUM
}

enum VideoProvider {
  CLOUDFLARE_STREAM
  NEY_MEDIA_CORE
}

enum ProcessingStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?
  role      UserRole @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watchProgress WatchProgress[]
  watchlist     WatchlistItem[]
  payments      Payment[]
  entitlements  Entitlement[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
}

model Film {
  id            String             @id @default(cuid())
  slug          String             @unique
  title         String
  synopsis      String
  genres        String[]
  releaseYear   Int
  duration      String
  posterUrl     String?
  backdropUrl   String?
  status        PublicationStatus  @default(DRAFT)
  accessType    AccessType         @default(FREE)
  trailerVideo  String?
  mainVideoId   String?
  publishedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  videoAssets   VideoAsset[]
  watchProgress WatchProgress[]
  watchlist     WatchlistItem[]
  entitlements  Entitlement[]
}

model VideoAsset {
  id             String          @id @default(cuid())
  filmId         String
  film           Film            @relation(fields: [filmId], references: [id], onDelete: Cascade)
  provider       VideoProvider
  providerVideoId String
  assetType      String
  processingStatus ProcessingStatus @default(QUEUED)
  duration       Int?
  metadata       Json?
  uploadedAt     DateTime?       @default(now())
  processedAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([filmId])
}

model WatchProgress {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  position  Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  film      Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([userId, filmId])
  @@index([userId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  filmId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  film      Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
  @@index([userId])
}

model Payment {
  id                   String    @id @default(cuid())
  userId               String
  provider             String
  providerTransactionId String?
  amountMinor          Int
  currency             String
  status               String
  idempotencyKey       String?
  verifiedAt           DateTime?
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  entitlements Entitlement[]
}

model Entitlement {
  id         String    @id @default(cuid())
  userId     String
  filmId     String?
  accessType AccessType
  startsAt   DateTime?
  expiresAt  DateTime?
  status     String    @default("ACTIVE")
  paymentId  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  film       Film?     @relation(fields: [filmId], references: [id], onDelete: Cascade)
  payment    Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  providerSubscriptionId String?
  plan                   String
  status                 String
  startedAt              DateTime  @default(now())
  renewedAt              DateTime?
  cancelledAt            DateTime?
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  resourceType String
  resourceId  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([resourceType, resourceId])
}
