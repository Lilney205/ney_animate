# ==============================================================================
# NEY Animate - Production Environment Variables for Vercel
# ==============================================================================

# Database (PostgreSQL hosted e.g. on Supabase, Neon, or your VPS)
DATABASE_URL="postgresql://user:password@db-host:5432/ney_animate?sslmode=require"

# Base URL of your deployed Next.js site
NEXT_PUBLIC_APP_URL="https://ney-animate.yourdomain.com"

# Admin Key for studio operations & content ingestion
STUDIO_BOOTSTRAP_KEY="replace-with-a-random-secure-admin-key"

# ==============================================================================
# NEY Media Core Connection
# ==============================================================================

# For Windows PC Self-Hosting + Vercel:
# 1. Start Media Core on your PC (docker compose up -d)
# 2. Run: cloudflared tunnel --url http://localhost:8080
# 3. Paste the generated https://*.trycloudflare.com URL below:
NEY_MEDIA_CORE_URL="http://localhost:8080"
NEXT_PUBLIC_MEDIA_CORE_URL="http://localhost:8080"

# Tenant Service Key matching 'ney-animate' in Media Core's SERVICE_KEYS_JSON
# (Found in ney-media-core/.env - never expose in client bundles)
NEY_MEDIA_CORE_SERVICE_KEY="replace-with-your-ney-animate-service-key"
